.ctb {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 900;
  display: flex; align-items: center;
  height: 110rpx; padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF; border-top: 1rpx solid #E4ECE6;
  box-shadow: 0 -4rpx 18rpx rgba(11, 59, 46, 0.06);
}
.ctb.dark { background: #1C2421; border-top-color: #2D3A35; }

.ctb-item {
  flex: 1; height: 100%; position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ctb-icon { font-size: 40rpx; line-height: 1; opacity: 0.55; filter: grayscale(0.5); }
.ctb-label { font-size: 20rpx; color: #6B7C72; margin-top: 6rpx; }
.ctb-item.active .ctb-icon { opacity: 1; filter: none; }
.ctb-item.active .ctb-label { color: #16A34A; font-weight: 700; }
.ctb.dark .ctb-label { color: #9CA3AF; }
.ctb.dark .ctb-item.active .ctb-label { color: #4ADE80; }

/* center raised primary button */
.ctb-item.center { overflow: visible; }
.ctb-fab {
  position: absolute; top: -40rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, #16A34A 0%, #0B3B2E 100%);
  color: #fff; font-size: 56rpx; font-weight: 600; line-height: 100rpx; text-align: center;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(22, 163, 74, 0.42);
}
.ctb.dark .ctb-fab { border-color: #1C2421; }
.ctb-item.center.active .ctb-fab { background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%); }
