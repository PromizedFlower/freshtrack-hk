page {
  --brand: #16A34A;
  --forest: #0B3B2E;
  --bg: #F4F7F4;
  --card: #FFFFFF;
  --card-subtle: #F4F7F4;
  --border: #E4ECE6;
  --text: #1F2A24;
  --muted: #6B7C72;
  --high: #DC2626;
  --medium: #F59E0B;
  --low: #16A34A;
  --info: #0EA5E9;
  --gold: #F59E0B;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* Page wrapper that carries theme / font-scale classes and redefines CSS vars. */
.page-root {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  box-sizing: border-box;
  /* leave room for the fixed custom tab bar (110rpx + safe area) */
  padding-bottom: 170rpx;
}

/* ---- Dark theme ---- */
.dark {
  --bg: #121816;
  --card: #1C2421;
  --card-subtle: #242E2A;
  --border: #2D3A35;
  --text: #F3F4F6;
  --muted: #9CA3AF;
}
.dark .btn-ghost { color: #D7E5DA; background: #1C2421; border-color: #2D3A35; }
.dark .card { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35); }

/* ---- Font scale (senior large text) ---- */
.font-large { font-size: 34rpx; }
.font-large .h1 { font-size: 52rpx; }
.font-large .h2 { font-size: 40rpx; }
.font-large .item-name, .font-large .rcp-title { font-size: 36rpx; }
.font-large .muted, .font-large .label { font-size: 30rpx; }

/* ---- Shared primitives ---- */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(11, 59, 46, 0.06);
  margin: 20rpx 24rpx;
  border: 1rpx solid var(--border);
}

.h1 { font-size: 44rpx; font-weight: 700; letter-spacing: 0.5rpx; }
.h2 { font-size: 34rpx; font-weight: 600; }
.muted { color: var(--muted); }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; }

.btn-primary {
  background: linear-gradient(135deg, #16A34A 0%, #0B3B2E 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 26rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 74, 0.28);
}
.btn-primary:active { opacity: 0.88; }

.btn-ghost {
  background: #fff;
  color: var(--forest);
  border: 2rpx solid #D7E5DA;
  border-radius: 999rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 600;
  font-size: 28rpx;
}

.page-loading { padding: 120rpx 0; text-align: center; color: var(--muted); }

/* ---- Segmented control (theme / mode / prefs) ---- */
.seg { display: flex; background: var(--card-subtle); padding: 6rpx; border-radius: 18rpx; border: 1rpx solid var(--border); }
.pseg {
  flex: 1; border: none; background: transparent; padding: 12rpx 0; border-radius: 14rpx;
  font-size: 26rpx; font-weight: 700; color: var(--muted); text-align: center;
}
.pseg.active { background: var(--card); color: var(--forest); box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06); }

/* ---- Scheme C hero ---- */
.hero-banner {
  border-radius: 28rpx; padding: 34rpx 32rpx; color: #FFFFFF; margin: 24rpx;
  position: relative; overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(11, 59, 46, 0.28);
  transition: background 0.6s ease;
}
.hero-banner.morning { background: linear-gradient(135deg, #0D4D3A 0%, #177255 55%, #D97706 100%); }
.hero-banner.afternoon { background: linear-gradient(135deg, #0A4333 0%, #15664C 55%, #B45309 100%); }
.hero-banner.night { background: linear-gradient(135deg, #061A14 0%, #0B2E24 60%, #1E3A8A 100%); }
.hero-pulse { display: inline-flex; align-items: center; gap: 8rpx; background: rgba(255,255,255,0.18); padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; margin-bottom: 16rpx; }
.pulse-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #34D399; box-shadow: 0 0 10rpx #34D399; }
.hero-title { font-size: 42rpx; font-weight: 800; margin-bottom: 6rpx; }
.hero-sub { font-size: 25rpx; opacity: 0.92; line-height: 1.45; margin-bottom: 22rpx; }
.hero-kpis { display: flex; gap: 10rpx; }
.kpi-box { flex: 1; background: rgba(255,255,255,0.14); padding: 16rpx 8rpx; border-radius: 18rpx; text-align: center; border: 1rpx solid rgba(255,255,255,0.12); }
.kpi-num { font-size: 36rpx; font-weight: 800; }
.kpi-label { font-size: 20rpx; opacity: 0.85; margin-top: 4rpx; }

/* ---- Zone quick jump ---- */
.zone-grid { display: flex; gap: 12rpx; margin: 4rpx 24rpx 20rpx; }
.zone-card { flex: 1; background: var(--card); padding: 20rpx 12rpx; border-radius: 20rpx; border: 1rpx solid var(--border); box-shadow: 0 8rpx 20rpx rgba(11,59,46,0.06); text-align: center; }
.zone-temp { font-size: 22rpx; font-weight: 800; color: var(--info); margin-bottom: 4rpx; }
.zone-name { font-size: 26rpx; font-weight: 700; margin-bottom: 4rpx; }
.zone-count { font-size: 20rpx; color: var(--muted); }

/* ---- Swipe physics row ---- */
.swipe-wrapper { position: relative; overflow: hidden; border-radius: 22rpx; margin: 0 24rpx 16rpx; }
.swipe-back { position: absolute; top: 0; bottom: 0; width: 50%; display: flex; align-items: center; font-size: 24rpx; font-weight: 700; color: #fff; padding: 0 24rpx; z-index: 1; }
.swipe-green { left: 0; background: #16A34A; justify-content: flex-start; }
.swipe-red { right: 0; background: #DC2626; justify-content: flex-end; }
.food-row {
  position: relative; background: var(--card); padding: 24rpx 26rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: space-between; box-shadow: 0 8rpx 20rpx rgba(11,59,46,0.06);
  border: 1rpx solid var(--border); z-index: 2;
}
.food-left { display: flex; align-items: center; gap: 18rpx; flex: 1; min-width: 0; }
.food-icon { width: 84rpx; height: 84rpx; border-radius: 22rpx; background: var(--card-subtle); display: flex; align-items: center; justify-content: center; font-size: 44rpx; flex-shrink: 0; }
.food-name { font-size: 30rpx; font-weight: 700; margin-bottom: 6rpx; }
.chip { display: inline-block; font-size: 20rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: 8rpx; margin-right: 8rpx; }
.chip-red { background: #FEE2E2; color: #DC2626; }
.chip-green { background: #DCFCE7; color: #16A34A; }
.chip-gold { background: #FEF3C7; color: #B45309; }
.dark .chip-red { background: rgba(220,38,38,0.2); color: #F87171; }
.dark .chip-green { background: rgba(22,163,74,0.2); color: #4ADE80; }
.dark .chip-gold { background: rgba(245,158,11,0.2); color: #FBBF24; }
.food-more { background: transparent; border: none; font-size: 40rpx; color: var(--muted); padding: 6rpx 12rpx; }

/* ---- Drawer / bottom sheet ---- */
.drawer-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; }
.drawer {
  position: fixed; left: 0; right: 0; bottom: 0; background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  /* large bottom padding keeps the action buttons clear of the fixed custom tab bar */
  padding: 28rpx 32rpx 170rpx;
  z-index: 1001; box-sizing: border-box;
  max-height: 90vh; overflow-y: auto;
}
.drawer-pill { width: 72rpx; height: 8rpx; background: #D1D5DB; border-radius: 8rpx; margin: 0 auto 24rpx; }
.drawer-title { font-size: 32rpx; font-weight: 800; margin-bottom: 24rpx; text-align: center; }

/* ---- Floating action button ---- */
.fab {
  position: fixed; right: 32rpx; bottom: 48rpx; width: 108rpx; height: 108rpx;
  border-radius: 50%; background: linear-gradient(135deg, #16A34A, #0B3B2E);
  color: #fff; font-size: 56rpx; font-weight: 600; text-align: center; line-height: 108rpx;
  box-shadow: 0 12rpx 28rpx rgba(11, 59, 46, 0.32);
}

/* ---- section title ---- */
.section-title { font-size: 30rpx; font-weight: 800; margin: 28rpx 28rpx 12rpx; color: var(--text); }

/* ---- 飛葉特效（滑動消化／丟棄共用，fridge + dashboard） ---- */
/* 卡片本身：消化上飄收斂 / 丟棄下墜淡出 */
@keyframes cardOutUp {
  0%   { opacity: 1; transform: translateX(0) translateY(0) rotate(0); }
  60%  { opacity: 1; transform: translateX(0) translateY(-36rpx) rotate(-2deg); }
  100% { opacity: 0; transform: translateX(0) translateY(-110rpx) rotate(3deg) scale(0.92); }
}
@keyframes cardOutDown {
  0%   { opacity: 1; transform: translateX(0) translateY(0) rotate(0); }
  60%  { opacity: 1; transform: translateX(0) translateY(30rpx) rotate(2deg); }
  100% { opacity: 0; transform: translateX(0) translateY(110rpx) rotate(-3deg) scale(0.92); }
}
.food-row.fx-consume { animation: cardOutUp 0.65s ease-in forwards; }
.food-row.fx-discard { animation: cardOutDown 0.65s ease-in forwards; }

/* 葉片本體（CSS 葉形：對角圓角） */
.leaf {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 30rpx;
  margin: -15rpx 0 0 -10rpx;
  border-radius: 0 60% 0 60%;
  opacity: 0;
  pointer-events: none;
  z-index: 5;
}
.leaf.consume { background: linear-gradient(135deg, #4ADE80, #16A34A); }
.leaf.discard { background: linear-gradient(135deg, #FBBF24, #DC2626); }

/* 消化：葉片向右上飄散盤旋 */
@keyframes leafFlyA { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(96rpx, -180rpx) rotate(320deg) scale(1); } }
@keyframes leafFlyB { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(-70rpx, -220rpx) rotate(-280deg) scale(0.9); } }
@keyframes leafFlyC { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(150rpx, -120rpx) rotate(400deg) scale(0.8); } }
@keyframes leafFlyD { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(30rpx, -260rpx) rotate(240deg) scale(1.1); } }

/* 丟棄：葉片向下飄落翻轉 */
@keyframes leafFallA { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(-110rpx, 170rpx) rotate(-300deg) scale(1); } }
@keyframes leafFallB { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(80rpx, 200rpx) rotate(260deg) scale(0.9); } }
@keyframes leafFallC { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(-160rpx, 90rpx) rotate(-380deg) scale(0.8); } }
@keyframes leafFallD { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg) scale(0.6); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(-30rpx, 240rpx) rotate(220deg) scale(1.1); } }

.leaf-1.consume { animation: leafFlyA 0.7s ease-out forwards; }
.leaf-2.consume { animation: leafFlyB 0.75s ease-out 0.05s forwards; }
.leaf-3.consume { animation: leafFlyC 0.7s ease-out 0.1s forwards; }
.leaf-4.consume { animation: leafFlyD 0.8s ease-out 0.08s forwards; }

.leaf-1.discard { animation: leafFallA 0.7s ease-in forwards; }
.leaf-2.discard { animation: leafFallB 0.75s ease-in 0.05s forwards; }
.leaf-3.discard { animation: leafFallC 0.7s ease-in 0.1s forwards; }
.leaf-4.discard { animation: leafFallD 0.8s ease-in 0.08s forwards; }

/* 中心擴散光暈脈衝 */
.fx-spark {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 90rpx;
  height: 90rpx;
  margin: -45rpx 0 0 -45rpx;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  z-index: 4;
}
@keyframes sparkPulse {
  0% { opacity: 0.75; transform: scale(0.35); }
  100% { opacity: 0; transform: scale(2.1); }
}
.fx-spark.consume { background: radial-gradient(circle, rgba(74, 222, 128, 0.55), transparent 70%); animation: sparkPulse 0.6s ease-out forwards; }
.fx-spark.discard { background: radial-gradient(circle, rgba(248, 113, 113, 0.5), transparent 70%); animation: sparkPulse 0.6s ease-out forwards; }
