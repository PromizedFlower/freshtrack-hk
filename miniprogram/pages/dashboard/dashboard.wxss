.swipe-tip {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--card-subtle); padding: 16rpx 24rpx; margin: 4rpx 24rpx 20rpx;
  border-radius: 16rpx; font-size: 22rpx; font-weight: 700; border: 1rpx solid var(--border);
}
.tip-green { color: var(--brand); }
.tip-red { color: var(--high); }
.tip-muted { color: var(--muted); font-size: 20rpx; }

.food-meta { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; }

.quick { display: flex; margin: 8rpx 12rpx 40rpx; }
.q-btn {
  flex: 1; margin: 0 12rpx; background: var(--card); border-radius: 20rpx; border: 1rpx solid var(--border);
  padding: 30rpx 12rpx; text-align: center; font-size: 26rpx; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(11, 59, 46, 0.06);
}
.q-ico { display: block; font-size: 44rpx; margin-bottom: 8rpx; }
