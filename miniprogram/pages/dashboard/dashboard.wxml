<view class="page-root {{theme}} {{font === 'large' ? 'font-large' : ''}}">

  <view wx:if="{{loading}}" class="page-loading">{{loadingTxt}}</view>

  <block wx:elif="{{hasData}}">
    <!-- Hero banner (Scheme C: gradient auto-switches by time of day) -->
    <view class="hero-banner {{period}}">
      <view class="hero-pulse">
        <view class="pulse-dot"></view>
        <text>📅 {{dateStr}} · {{clock}}</text>
      </view>
      <view class="hero-title">{{greeting}}</view>
      <view class="hero-sub" wx:if="{{kpi}}">
        {{kpi.expiring_soon > 0 ? '⚠️ ' : ''}}{{kpi.expiring_soon + ' 件食材即將過期'}}
      </view>
      <view class="hero-kpis" wx:if="{{kpi}}">
        <view class="kpi-box">
          <view class="kpi-num">{{kpi.total_tracked}}</view>
          <view class="kpi-label">{{kpiInFridge}}</view>
        </view>
        <view class="kpi-box">
          <view class="kpi-num">{{kpi.expiring_soon}}</view>
          <view class="kpi-label">{{kpiExpiring}}</view>
        </view>
        <view class="kpi-box">
          <view class="kpi-num">{{kpi.month_saved_kg}}kg</view>
          <view class="kpi-label">{{kpiSaved}}</view>
        </view>
      </view>
    </view>

    <!-- 3-zone quick jump -->
    <view class="zone-grid">
      <view class="zone-card" data-zone="fridge" bindtap="goFridgeZone">
        <view class="zone-temp">🧊 4°C</view>
        <view class="zone-name">{{zoneFridge}}</view>
        <view class="zone-count">{{zoneCounts.fridge}}</view>
      </view>
      <view class="zone-card" data-zone="freezer" bindtap="goFridgeZone">
        <view class="zone-temp">❄️ -18°C</view>
        <view class="zone-name">{{zoneFreezer}}</view>
        <view class="zone-count">{{zoneCounts.freezer}}</view>
      </view>
      <view class="zone-card" data-zone="pantry" bindtap="goFridgeZone">
        <view class="zone-temp">🗄️ —</view>
        <view class="zone-name">{{zonePantry}}</view>
        <view class="zone-count">{{zoneCounts.pantry}}</view>
      </view>
    </view>

    <!-- swipe feed -->
    <view class="swipe-wrapper" wx:for="{{items}}" wx:key="id">
      <view class="swipe-back swipe-green">✓ {{tConsume}}</view>
      <view class="swipe-back swipe-red">{{tDiscard}} 🗑️</view>

      <!-- 飛葉特效粒子層 -->
      <block wx:if="{{item.fx}}">
        <view class="leaf leaf-1 {{item.fx}}"></view>
        <view class="leaf leaf-2 {{item.fx}}"></view>
        <view class="leaf leaf-3 {{item.fx}}"></view>
        <view class="leaf leaf-4 {{item.fx}}"></view>
        <view class="fx-spark {{item.fx}}"></view>
      </block>

      <view class="food-row {{item.fx ? 'fx-' + item.fx : ''}}"
            style="transform: translateX({{item.offset}}px);"
            data-id="{{item.id}}"
            bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
        <view class="food-left">
          <view class="food-icon">{{item.icon}}</view>
          <view class="grow">
            <view class="food-name">{{item.name}}</view>
            <view class="food-meta">
              <text class="chip {{item.risk_level === 'high' ? 'chip-red' : (item.risk_level === 'medium' ? 'chip-gold' : 'chip-green')}}">{{item.days_left}}d</text>
              <text class="muted">{{item.date_type === 'use_by' ? '此日期前食用' : '最佳賞味期'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- quick actions -->
    <view class="quick">
      <view class="q-btn" bindtap="goAdd"><text class="q-ico">＋</text>{{quickAdd}}</view>
      <view class="q-btn" bindtap="goRecipes"><text class="q-ico">🍳</text>{{quickRecipes}}</view>
      <view class="q-btn" bindtap="goImpact"><text class="q-ico">🌱</text>{{quickImpact}}</view>
    </view>
  </block>

  <view wx:else class="page-loading">{{noDataTxt}}</view>
</view>
