<view class="page-root login-root {{theme}} {{font === 'large' ? 'font-large' : ''}}">

  <view class="brand">
    <view class="logo">FT</view>
    <view class="brand-name">FreshTrack HK</view>
    <view class="muted">{{tagline}}</view>
  </view>

  <view class="card">
    <input class="field" type="text" placeholder="{{emailPh}}" placeholder-class="ph"
           value="{{email}}" bindinput="onEmail" />
    <input class="field" type="password" placeholder="{{pwdPh}}" placeholder-class="ph"
           value="{{password}}" bindinput="onPwd" />
    <view class="err" wx:if="{{error}}">{{error}}</view>
    <button class="btn-primary" loading="{{loading}}" bindtap="doLogin">{{loginBtn}}</button>
    <button class="btn-ghost" loading="{{loading}}" bindtap="doSignup">{{signupBtn}}</button>
  </view>

  <view class="demo">
    <view class="demo-head">
      <view class="demo-title">{{demoTitle}}</view>
      <view class="muted">{{demoSub}}</view>
    </view>

    <view class="account" wx:for="{{accounts}}" wx:key="email"
          data-email="{{item.email}}" bindtap="demoLogin">
      <view class="avatar">{{item.emoji}}</view>
      <view class="grow">
        <view class="a-name">{{item.name}}</view>
        <view class="a-email">{{item.email}}</view>
      </view>
      <view class="role-chip {{item.role}}">{{item.roleLabel}}</view>
    </view>
  </view>

</view>
