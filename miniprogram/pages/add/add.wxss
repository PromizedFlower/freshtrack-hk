.modes { display: flex; margin: 20rpx 24rpx; }
.mode {
  flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: var(--muted);
  background: #fff; border: 2rpx solid #E4ECE6;
}
.mode:first-child { border-radius: 16rpx 0 0 16rpx; }
.mode:last-child { border-radius: 0 16rpx 16rpx 0; }
.mode.on { background: var(--forest); color: #fff; border-color: var(--forest); font-weight: 600; }

.scan-box { text-align: center; }
.tip { font-size: 24rpx; margin-top: 16rpx; }

.det { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #F0F4F0; }
.det-name { font-size: 30rpx; font-weight: 600; }

.field { margin: 20rpx 0; }
.label { font-size: 24rpx; color: var(--muted); margin-bottom: 8rpx; }
.input, .picker { background: #F4F7F4; border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 28rpx; }
