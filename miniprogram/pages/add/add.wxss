.modes { display: flex; margin: 20rpx 24rpx; }
.mode {
  flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: var(--muted);
  background: var(--card); border: 2rpx solid var(--border);
}
.mode:first-child { border-radius: 16rpx 0 0 16rpx; }
.mode:last-child { border-radius: 0 16rpx 16rpx 0; }
.mode.on { background: var(--forest); color: #fff; border-color: var(--forest); font-weight: 600; }

.scan-box { text-align: center; }
.tip { font-size: 24rpx; margin-top: 16rpx; }

.det { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.det-name { font-size: 30rpx; font-weight: 600; }

.cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-bottom: 8rpx; }
.cat-item {
  background: var(--card-subtle); border: 2rpx solid var(--border); padding: 20rpx 6rpx;
  border-radius: 16rpx; text-align: center;
}
.cat-item.active { background: #DCFCE7; border-color: var(--brand); }
.dark .cat-item.active { background: rgba(22,163,74,0.2); }
.cat-icon { font-size: 40rpx; margin-bottom: 6rpx; }
.cat-name { font-size: 22rpx; }

.field { margin: 20rpx 0; }
.field.grow { margin-right: 12rpx; }
.field.grow + .field.grow { margin-left: 12rpx; margin-right: 0; }
.label { font-size: 24rpx; color: var(--muted); margin-bottom: 8rpx; }
.input, .picker { background: var(--card-subtle); border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 28rpx; }
