<view class="page-root {{theme}} {{font === 'large' ? 'font-large' : ''}}">

  <view class="modes">
    <view class="mode {{mode === 'receipt' ? 'on' : ''}}" data-mode="receipt" bindtap="setMode">🧾 {{modeReceipt}}</view>
    <view class="mode {{mode === 'food' ? 'on' : ''}}" data-mode="food" bindtap="setMode">📸 {{modeFood}}</view>
    <view class="mode {{mode === 'manual' ? 'on' : ''}}" data-mode="manual" bindtap="setMode">✏️ {{modeManual}}</view>
  </view>

  <!-- AI scan -->
  <block wx:if="{{mode !== 'manual'}}">
    <view class="card scan-box">
      <button class="btn-primary" loading="{{scanning}}" bindtap="chooseImage">
        {{scanning ? scanning : (mode === 'receipt' ? scanReceipt : scanFood)}}
      </button>
      <view class="muted tip">百佳 / 惠康 / HKTVmall · 自動識別名稱、數量與保質期</view>
    </view>

    <view class="card" wx:if="{{detected.length > 0}}">
      <view class="h2">{{detectedTitle}}</view>
      <view class="det" wx:for="{{detected}}" wx:for-index="di" wx:key="di">
        <view class="grow">
          <view class="det-name">{{item.name}}</view>
          <view class="muted">{{item.category}} · {{item.expiry_date || item.suggested_expiry_date}}</view>
        </view>
      </view>
      <button class="btn-primary" bindtap="confirmDetected">{{confirmAdd}} ({{detected.length}})</button>
    </view>
  </block>

  <!-- manual form -->
  <block wx:else>
    <view class="section-title">{{addTitle}}</view>

    <view class="card">
      <view class="label">{{catTitle}}</view>
      <view class="cat-grid">
        <view class="cat-item {{pickIndex === index ? 'active' : ''}}"
              wx:for="{{cats}}" wx:key="id" data-index="{{index}}" bindtap="selectCat">
          <view class="cat-icon">{{item.icon}}</view>
          <view class="cat-name">{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <view class="label">{{labelName}}</view>
        <input class="input" value="{{form.name}}" data-key="name" bindinput="onInput" placeholder="{{addNamePh}}" />
      </view>

      <view class="row">
        <view class="field grow">
          <view class="label">數量</view>
          <input class="input" type="number" value="{{form.quantity}}" data-key="quantity" bindinput="onInput" />
        </view>
        <view class="field grow">
          <view class="label">單位</view>
          <input class="input" value="{{form.unit}}" data-key="unit" bindinput="onInput" placeholder="pcs" />
        </view>
      </view>

      <view class="row">
        <view class="field grow">
          <view class="label">重量(g)</view>
          <input class="input" type="number" value="{{form.weight_grams}}" data-key="weight_grams" bindinput="onInput" />
        </view>
        <view class="field grow">
          <view class="label">{{addPrice}}</view>
          <input class="input" type="digit" value="{{form.price_hkd}}" data-key="price_hkd" bindinput="onInput" />
        </view>
      </view>

      <view class="field">
        <view class="label">{{labelType}}</view>
        <picker range="{{typeLabels}}" value="{{form.date_type === 'use_by' ? 1 : 0}}" bindchange="onType">
          <view class="picker">{{typeLabels[form.date_type === 'use_by' ? 1 : 0]}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">{{labelExpiry}}</view>
        <picker mode="date" value="{{form.expiry_date}}" bindchange="onExpiry">
          <view class="picker">{{form.expiry_date}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">{{addZone}}</view>
        <picker range="{{zoneLabels}}" bindchange="onZone">
          <view class="picker">{{zoneLabels[form.storage_zone === 'freezer' ? 1 : (form.storage_zone === 'pantry' ? 2 : 0)]}}</view>
        </picker>
      </view>

      <button class="btn-primary" bindtap="saveManual">✓ {{addSave}}</button>
    </view>
  </block>
</view>
