.mode-bar { margin: 24rpx 24rpx 0; }

.rcp-title { font-size: 30rpx; font-weight: 700; }
.rcp-meta { font-size: 24rpx; margin-top: 4rpx; }
.score { font-size: 32rpx; font-weight: 800; color: var(--brand); }

.rcp-tags { display: flex; gap: 12rpx; margin-top: 14rpx; }
.count { font-size: 24rpx; font-weight: 700; color: var(--muted); margin-left: 8rpx; }
.rcp-matched { font-size: 22rpx; color: var(--brand); margin-top: 10rpx; }
.dark .rcp-matched { color: #4ADE80; }
.empty-recipe { text-align: center; padding: 48rpx 28rpx; }
.empty-emoji { font-size: 64rpx; margin-bottom: 12rpx; }

.sec-head { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 28rpx 12rpx; }
.sec-head .section-title { margin: 0; }
.add-link { color: var(--brand); font-size: 26rpx; font-weight: 700; }
.del-link { color: var(--high); font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.my-note { font-size: 24rpx; margin-top: 6rpx; }
.rec-note { width: 100%; box-sizing: border-box; min-height: 120rpx; }
.label { font-size: 24rpx; color: var(--muted); margin: 16rpx 0 8rpx; font-weight: 600; }
.input { background: var(--card-subtle); border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 28rpx; }
.tag { font-size: 22rpx; color: var(--forest); background: #EAF7EE; border-radius: 10rpx; padding: 6rpx 14rpx; }
.dark .tag { background: rgba(22,163,74,0.2); color: #4ADE80; }

.detail { margin-top: 16rpx; border-top: 1rpx solid var(--border); padding-top: 16rpx; }
.sec { font-size: 24rpx; font-weight: 700; color: var(--muted); margin: 12rpx 0 8rpx; }
.ing, .step { font-size: 26rpx; padding: 4rpx 0; }
.sub { color: var(--muted); font-size: 24rpx; }
.cook { margin-top: 20rpx; }

.ai-box { }
.ai-title { font-size: 32rpx; font-weight: 800; margin-bottom: 16rpx; }
.ai-input {
  background: var(--card-subtle); border-radius: 14rpx;
  padding: 22rpx 24rpx; font-size: 28rpx; line-height: 1.5;
  width: 100%; box-sizing: border-box; min-height: 140rpx;
}
.ai-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-ai { flex: 1; background: var(--forest); color: #fff; border-radius: 999rpx; font-weight: 600; font-size: 28rpx; padding: 20rpx; }
.presets { margin-top: 16rpx; display: flex; flex-direction: column; gap: 12rpx; }
.preset { background: var(--card-subtle); border: 1rpx dashed var(--border); padding: 18rpx 22rpx; border-radius: 14rpx; font-size: 26rpx; color: var(--forest); }
.ai-error { color: var(--high); font-size: 24rpx; margin-top: 12rpx; }
.ai-disclaimer { color: var(--muted); font-size: 22rpx; margin-top: 12rpx; }

.rcp.ai { border-left: 6rpx solid var(--brand); }
.ai-badge { background: var(--forest); color: #fff; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.ai-reason { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.ai-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.mini { flex: 1; border-radius: 999rpx; font-size: 24rpx; padding: 12rpx 0; }
