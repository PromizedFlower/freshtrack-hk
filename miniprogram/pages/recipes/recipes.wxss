.rcp-title { font-size: 32rpx; font-weight: 600; }
.rcp-meta { font-size: 24rpx; margin-top: 4rpx; }
.score { font-size: 40rpx; font-weight: 700; color: var(--brand); }
.rcp-tags { margin-top: 12rpx; }
.tag { display: inline-block; background: #EAF7EE; color: var(--forest); border-radius: 999rpx; padding: 4rpx 16rpx; font-size: 22rpx; margin-right: 12rpx; }

.detail { margin-top: 20rpx; border-top: 1rpx solid #F0F4F0; padding-top: 20rpx; }
.sec { font-size: 26rpx; font-weight: 600; color: var(--forest); margin: 16rpx 0 8rpx; }
.ing { font-size: 26rpx; padding: 6rpx 0; }
.step { font-size: 26rpx; color: #4A5B51; padding: 6rpx 0; }
.cook { margin-top: 20rpx; }

/* ---------- AI 主动触发区 ---------- */
.ai-box {
  background: linear-gradient(135deg, #EAF7EE 0%, #F4FBF6 100%);
  border: 2rpx solid #CFEBD9;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
}
.ai-title { font-size: 30rpx; font-weight: 700; color: var(--forest); margin-bottom: 16rpx; }
.ai-input {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.ai-row { display: flex; gap: 16rpx; }
.btn-ai {
  flex: 1;
  background: linear-gradient(135deg, #16A34A 0%, #0B3B2E 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx;
  text-align: center;
}
.btn-ai-ask {
  flex: 1;
  background: #fff;
  color: var(--forest);
  border: 2rpx solid #B8DFC5;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx;
  text-align: center;
}
.ai-error { color: var(--high); font-size: 24rpx; margin-top: 12rpx; }
.ai-disclaimer { color: var(--muted); font-size: 22rpx; margin-top: 12rpx; line-height: 1.5; }

/* ---------- AI 结果卡 ---------- */
.ai-badge {
  background: var(--forest);
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.ai-reason { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.ai-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.mini { margin: 0; flex: 1; }
.sub { color: var(--medium); }

/* ---------- 本地清单标题 ---------- */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--forest);
  margin: 24rpx 28rpx 0;
}
