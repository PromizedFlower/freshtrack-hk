<view class="page-root {{theme}} {{font === 'large' ? 'font-large' : ''}}">

  <view wx:if="{{loading}}" class="page-loading">{{loadingTxt}}</view>

  <block wx:elif="{{hasData}}">
    <!-- dual-mode switch -->
    <view class="seg mode-bar">
      <view class="pseg {{mode === 'explore' ? 'active' : ''}}" data-mode="explore" bindtap="setMode">📖 {{tExplore}}</view>
      <view class="pseg {{mode === 'chef' ? 'active' : ''}}" data-mode="chef" bindtap="setMode">👨‍🍳 {{tChef}}</view>
    </view>

    <!-- Mode 1: local rescue list -->
    <block wx:if="{{mode === 'explore'}}">
      <view class="section-title">{{weeklyRescue}}<text wx:if="{{recipes.length}}" class="count">· {{recipes.length}}</text></view>
      <view class="card rcp" wx:for="{{recipes}}" wx:key="id">
        <view class="row" data-id="{{item.id}}" bindtap="toggle">
          <view class="grow">
            <view class="rcp-title">{{item.title}}</view>
            <view class="muted rcp-meta">{{item.prep_time_min}} {{min}} · {{item.difficulty}} · {{item.servings}} {{servings}}</view>
          </view>
          <view class="score">{{item.match_score}}%</view>
        </view>
        <view class="rcp-tags">
          <text class="tag">{{useExpiring}} {{item.expiring_used_count}}</text>
          <text class="tag">{{saveKg}} {{item.waste_saved_kg}}kg</text>
        </view>
        <view wx:if="{{item.matchedText}}" class="rcp-matched">🔎 {{matchedWith}} {{item.matchedText}}</view>
        <view wx:if="{{expandedId === item.id}}" class="detail">
          <view class="sec">{{lang === 'en' ? 'Ingredients' : '用料'}}</view>
          <view class="ing" wx:for="{{item.ingredients}}" wx:for-item="ing" wx:key="name">{{ing.name}}</view>
          <view class="sec">{{lang === 'en' ? 'Steps' : '步骤'}}</view>
          <view class="step" wx:for="{{item.steps}}" wx:for-item="s" wx:for-index="si" wx:key="*this">{{si + 1}}. {{s}}</view>
          <button class="btn-primary cook" data-id="{{item.id}}" bindtap="cook">{{cook}}</button>
        </view>
      </view>
      <view wx:if="{{recipes.length === 0}}" class="card empty-recipe">
        <view class="empty-emoji">🥬</view>
        <view class="muted">{{emptyHint}}</view>
      </view>
    </block>

    <!-- Mode 2: AI chef -->
    <block wx:else>
      <view class="ai-box card">
        <view class="ai-title">👨‍🍳 {{aiTitle}}</view>
        <textarea class="ai-input" placeholder="{{aiPlaceholder}}" value="{{query}}" bindinput="onQueryInput" auto-height maxlength="200" />
        <view class="ai-row">
          <button class="btn-ai" bindtap="onAsk" disabled="{{aiLoading}}">{{aiLoading ? aiGenerating : aiAsk}}</button>
        </view>
        <view class="presets">
          <view class="preset" wx:for="{{presets}}" wx:key="*this" data-query="{{item}}" bindtap="onPreset">💬 {{item}}</view>
        </view>
        <view wx:if="{{aiError}}" class="ai-error">{{aiError}}</view>
        <view wx:if="{{aiDisclaimer}}" class="ai-disclaimer">{{aiDisclaimer}}</view>
      </view>

      <view class="card rcp ai" wx:for="{{aiRecipes}}" wx:for-index="aiIdx" wx:key="title">
        <view class="row">
          <view class="grow">
            <view class="rcp-title">🤖 {{item.title}}</view>
            <view class="muted rcp-meta">{{item.prep_time_min}} {{min}} · {{item.difficulty}} · {{item.servings}} {{servings}}</view>
          </view>
          <view class="ai-badge">AI</view>
        </view>
        <view wx:if="{{item.reason}}" class="ai-reason">{{item.reason}}</view>
        <view class="ai-actions">
          <button class="btn-ghost mini" size="mini" data-idx="{{aiIdx}}" bindtap="save">{{fav}}</button>
          <button class="btn-ghost mini" size="mini" data-idx="{{aiIdx}}" bindtap="cookAi">{{cook}}</button>
          <button class="btn-ghost mini" size="mini" data-idx="{{aiIdx}}" bindtap="toggleAi">{{item._open ? collapse : detail}}</button>
        </view>
        <view wx:if="{{item._open}}" class="detail">
          <view class="sec">{{lang === 'en' ? 'Ingredients' : '用料'}}</view>
          <view class="ing" wx:for="{{item.ingredients}}" wx:for-item="ing" wx:key="name">{{ing.name}}<text wx:if="{{ing.substitute}}" class="sub">（{{lang === 'en' ? 'sub:' : '可替'}} {{ing.substitute}}）</text></view>
          <view class="sec">{{lang === 'en' ? 'Steps' : '步骤'}}</view>
          <view class="step" wx:for="{{item.steps}}" wx:for-item="s" wx:for-index="si" wx:key="*this">{{si + 1}}. {{s}}</view>
        </view>
      </view>
    </block>
  </block>

  <view wx:else class="page-loading">{{noDataTxt}}</view>
</view>
