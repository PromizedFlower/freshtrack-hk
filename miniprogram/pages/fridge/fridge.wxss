/* FreshTrack HK — fridge 頁專屬樣式（溫區 Tab 定位條）
   飛葉特效等共用樣式見 app.wxss */

/* ===== 溫區快速定位 Tab 條（sticky 跟隨滾動） ===== */
.zone-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  margin: 0 -24rpx 8rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
  backdrop-filter: blur(8rpx);
}
.zone-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: var(--card-subtle);
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease;
}
.zone-tab:active { transform: scale(0.94); }
.zone-tab.active {
  border-color: var(--brand);
  background: #DCFCE7;
}
.dark .zone-tab.active { background: rgba(22, 163, 74, 0.22); }
.zt-icon { font-size: 26rpx; }
.zt-label { font-size: 26rpx; font-weight: 700; color: var(--forest); }
.dark .zt-label { color: #4ADE80; }
.zt-count {
  min-width: 34rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--muted);
  background: var(--card);
  border-radius: 999rpx;
  padding: 2rpx 8rpx;
}
