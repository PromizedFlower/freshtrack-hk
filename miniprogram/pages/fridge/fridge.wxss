.item { display: flex; align-items: flex-start; }
.item-name { font-size: 32rpx; font-weight: 600; margin-right: 16rpx; }
.meta { font-size: 24rpx; margin-top: 6rpx; }
.suggest { font-size: 24rpx; color: var(--brand); background: #EAF7EE; border-radius: 12rpx; padding: 8rpx 16rpx; margin-top: 12rpx; display: inline-block; }
.ops { display: flex; flex-direction: column; gap: 12rpx; margin-left: 16rpx; }
.op { margin: 0 !important; border-radius: 999rpx; font-size: 22rpx; }
.op-done { background: #16A34A; color: #fff; }
.op-del { background: #fff; color: #DC2626; border: 1rpx solid #FECACA; }

.fab {
  position: fixed; right: 32rpx; bottom: 48rpx; width: 108rpx; height: 108rpx;
  border-radius: 50%; background: linear-gradient(135deg, #16A34A, #0B3B2E);
  color: #fff; font-size: 56rpx; font-weight: 600; text-align: center; line-height: 108rpx;
  box-shadow: 0 12rpx 28rpx rgba(11, 59, 46, 0.32);
}
