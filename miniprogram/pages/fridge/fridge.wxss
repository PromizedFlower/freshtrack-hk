.zone-section { margin-bottom: 8rpx; }
.zone-head { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 28rpx 12rpx; }
.zone-head-left { display: flex; align-items: center; gap: 12rpx; }
.zone-head-icon { font-size: 34rpx; }
.zone-head-name { font-size: 32rpx; font-weight: 800; }
.zone-head-temp { font-size: 22rpx; color: var(--info); font-weight: 700; }
.zone-head-count { font-size: 24rpx; color: var(--muted); }

.empty-zone { padding: 16rpx 28rpx 24rpx; color: var(--muted); font-size: 24rpx; }

.food-meta { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; }
.suggest { font-size: 22rpx; color: var(--brand); background: #EAF7EE; border-radius: 10rpx; padding: 6rpx 14rpx; margin-top: 10rpx; display: inline-block; }
.dark .suggest { background: rgba(22,163,74,0.2); }

.field { margin: 20rpx 0; }
.label { font-size: 24rpx; color: var(--muted); margin-bottom: 8rpx; }
.input, .picker { background: var(--card-subtle); border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 28rpx; }

.drawer-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.drawer-actions .btn-primary, .drawer-actions .btn-ghost { flex: 1; border-radius: 999rpx; padding: 24rpx; font-size: 28rpx; }
