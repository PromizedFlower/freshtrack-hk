<view class="page-root {{theme}} {{font === 'large' ? 'font-large' : ''}}">

  <view wx:if="{{loading}}" class="page-loading">{{loadingTxt}}</view>

  <block wx:elif="{{hasData}}">
    <view class="section-title">{{title}}</view>

    <!-- 溫區快速定位 Tab 條（sticky） -->
    <view class="zone-tabs">
      <view class="zone-tab {{activeZone === item.zone ? 'active' : ''}}"
            wx:for="{{zones}}" wx:key="zone"
            data-zone="{{item.zone}}" bindtap="jumpZone">
        <text class="zt-icon">{{item.icon}}</text>
        <text class="zt-label">{{item.label}}</text>
        <text class="zt-count">{{item.items.length}}</text>
      </view>
    </view>

    <view class="zone-section" wx:for="{{zones}}" wx:key="zone" id="zone-{{item.zone}}">
      <view class="zone-head">
        <view class="zone-head-left">
          <text class="zone-head-icon">{{item.icon}}</text>
          <text class="zone-head-name">{{item.label}}</text>
          <text class="zone-head-temp">{{item.temp}}</text>
        </view>
        <text class="zone-head-count">{{item.items.length}}</text>
      </view>

      <view wx:if="{{item.items.length === 0}}" class="empty-zone">{{emptyZone}}</view>

      <view class="swipe-wrapper" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
        <view class="swipe-back swipe-green">✓ {{tConsume}}</view>
        <view class="swipe-back swipe-red">{{tDiscard}} 🗑️</view>

        <!-- 飛葉特效粒子層：消化（上飄）／丟棄（飄落） -->
        <block wx:if="{{it.fx}}">
          <view class="leaf leaf-1 {{it.fx}}"></view>
          <view class="leaf leaf-2 {{it.fx}}"></view>
          <view class="leaf leaf-3 {{it.fx}}"></view>
          <view class="leaf leaf-4 {{it.fx}}"></view>
          <view class="fx-spark {{it.fx}}"></view>
        </block>

        <view class="food-row {{it.fx ? 'fx-' + it.fx : ''}}"
              style="transform: translateX({{it.offset}}px);"
              data-id="{{it.id}}"
              bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
          <view class="food-left">
            <view class="food-icon">{{it.icon}}</view>
            <view class="grow">
              <view class="food-name">{{it.name}}</view>
              <view class="food-meta">
                <text class="chip {{it.risk_level === 'high' ? 'chip-red' : (it.risk_level === 'medium' ? 'chip-gold' : 'chip-green')}}">{{it.days_left}}d</text>
                <text class="muted">{{it.category}} · {{it.quantity}}{{it.unit}}</text>
              </view>
              <view class="suggest" wx:if="{{it.suggested_action}}">{{it.suggested_action}}</view>
            </view>
          </view>
          <view class="food-more" data-id="{{it.id}}" catchtap="openEdit">⋯</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="page-loading">{{noDataTxt}}</view>



  <!-- edit drawer -->
  <view wx:if="{{editId}}" class="drawer-mask" bindtap="closeEdit"></view>
  <view wx:if="{{editId}}" class="drawer">
    <view class="drawer-pill"></view>
    <view class="drawer-title">{{editItem}}</view>

    <view class="field">
      <view class="label">{{labelName}}</view>
      <input class="input" value="{{editName}}" bindinput="onEditName" />
    </view>

    <view class="field">
      <view class="label">{{labelZone}}</view>
      <view class="seg">
        <view class="pseg {{editZone === 'fridge' ? 'active' : ''}}" data-zone="fridge" bindtap="setEditZone">🧊 {{zoneFridge}}</view>
        <view class="pseg {{editZone === 'freezer' ? 'active' : ''}}" data-zone="freezer" bindtap="setEditZone">❄️ {{zoneFreezer}}</view>
        <view class="pseg {{editZone === 'pantry' ? 'active' : ''}}" data-zone="pantry" bindtap="setEditZone">🗄️ {{zonePantry}}</view>
      </view>
    </view>

    <view class="field">
      <view class="label">{{labelType}}</view>
      <picker range="{{typeLabels}}" value="{{editType === 'use_by' ? 1 : 0}}" bindchange="onEditType">
        <view class="picker">{{typeLabels[editType === 'use_by' ? 1 : 0]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">{{labelExpiry}}</view>
      <picker mode="date" value="{{editExpiry}}" bindchange="onEditExpiry">
        <view class="picker">{{editExpiry}}</view>
      </picker>
    </view>

    <view class="drawer-actions">
      <button class="btn-ghost" bindtap="closeEdit">{{cancel}}</button>
      <button class="btn-primary" bindtap="saveEdit">{{save}}</button>
    </view>
  </view>
</view>
