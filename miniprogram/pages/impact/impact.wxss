.hero { padding: 32rpx 32rpx 8rpx; }
.hero .muted { margin-top: 4rpx; }

.profile { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #16A34A, #0B3B2E); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
}
.pname { font-size: 32rpx; font-weight: 700; }
.pemail { font-size: 22rpx; color: var(--muted); }
.phouse { font-size: 22rpx; color: var(--forest); margin-top: 4rpx; font-weight: 600; }
.dark .phouse { color: #4ADE80; }
.signout {
  font-size: 22rpx; color: var(--high); font-weight: 700; flex-shrink: 0;
  border: 1rpx solid var(--high); border-radius: 999rpx; padding: 8rpx 20rpx;
}

.family { margin-top: 24rpx; }
.fam-meta { margin: 12rpx 0 4rpx; }
.fam-name { font-size: 28rpx; font-weight: 700; }
.fam-invite { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.fam-invite .copy { color: var(--brand); font-weight: 700; margin-left: 8rpx; }
.member-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); }
.member-row:last-child { border-bottom: none; }
.m-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--card-subtle); display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: var(--forest);
}
.dark .m-avatar { color: #4ADE80; }
.m-name { font-size: 28rpx; font-weight: 600; }
.m-email { font-size: 22rpx; color: var(--muted); }
.self-tag {
  font-size: 18rpx; color: var(--brand); background: #DCFCE7; border-radius: 6rpx;
  padding: 2rpx 8rpx; margin-left: 8rpx; font-weight: 700;
}
.dark .self-tag { background: rgba(22,163,74,0.2); color: #4ADE80; }
.role-chip { font-size: 22rpx; font-weight: 700; padding: 6rpx 20rpx; border-radius: 999rpx; color: #fff; flex-shrink: 0; }
.role-chip.owner { background: var(--forest); }
.role-chip.editor { background: #0EA5E9; }
.role-chip.viewer { background: #6B7280; }

.fam-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.fam-btn {
  flex: 1; text-align: center; font-size: 24rpx; font-weight: 700; padding: 14rpx 0;
  border-radius: 999rpx; background: var(--card-subtle); border: 1rpx solid var(--border); color: var(--forest);
}
.dark .fam-btn { color: #4ADE80; }
.fam-btn.danger { color: var(--high); }
.hh-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.hh-row:last-child { border-bottom: none; }
.hh-name { font-size: 30rpx; font-weight: 700; }
.hh-meta { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.err { color: var(--high); font-size: 24rpx; margin: 8rpx 0; }

.bigs { display: flex; }
.big { flex: 1; text-align: center; }
.big + .big { border-left: 1rpx solid var(--border); }
.big-num { font-size: 44rpx; font-weight: 700; color: var(--forest); }
.dark .big-num { color: #4ADE80; }
.big-num .u { font-size: 22rpx; color: var(--muted); font-weight: 500; }
.big .muted { font-size: 24rpx; }

.chart { display: flex; align-items: flex-end; height: 320rpx; margin-top: 24rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar-val { font-size: 20rpx; color: var(--muted); margin-bottom: 6rpx; }
.bar-wrap { width: 36rpx; height: 220rpx; display: flex; align-items: flex-end; background: var(--card-subtle); border-radius: 12rpx; overflow: hidden; }
.bar { width: 100%; background: linear-gradient(180deg, #16A34A, #0B3B2E); border-radius: 12rpx 12rpx 0 0; }
.bar-label { font-size: 20rpx; color: var(--muted); margin-top: 8rpx; }

.link { color: var(--brand); font-size: 26rpx; font-weight: 700; }

.restock-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.restock-row:last-child { border-bottom: none; }
.restock-name { font-size: 28rpx; font-weight: 600; }
.bought-tag { font-size: 20rpx; color: var(--muted); margin-left: 12rpx; }
.restock-btns { display: flex; gap: 12rpx; }
.rbtn { font-size: 22rpx; font-weight: 700; padding: 8rpx 20rpx; border-radius: 999rpx; }
.rbtn.ok { background: #DCFCE7; color: #16A34A; }
.rbtn.del { background: #FEE2E2; color: #DC2626; }
.dark .rbtn.ok { background: rgba(22,163,74,0.2); color: #4ADE80; }
.dark .rbtn.del { background: rgba(220,38,38,0.2); color: #F87171; }
.empty { text-align: center; padding: 24rpx 0; }

.pref-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.pref-row:last-child { border-bottom: none; }
.pref-lbl { font-size: 26rpx; font-weight: 600; }
.mini-seg { width: 320rpx; }

.field { margin: 20rpx 0; }
.input { background: var(--card-subtle); border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 28rpx; }
.drawer-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.drawer-actions .btn-primary, .drawer-actions .btn-ghost { flex: 1; border-radius: 999rpx; padding: 24rpx; font-size: 28rpx; }
