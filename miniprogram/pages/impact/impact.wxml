<view class="page-root {{theme}} {{font === 'large' ? 'font-large' : ''}}">

  <!-- user profile -->
  <view class="card profile" wx:if="{{me}}">
    <view class="avatar">{{initial}}</view>
    <view class="grow">
      <view class="pname">{{me.display_name}}</view>
      <view class="pemail">{{me.email}}</view>
      <view class="phouse">🏠 {{householdText}}</view>
    </view>
    <view class="signout" bindtap="signOut">{{signOut}}</view>
  </view>

  <!-- family (household members) -->
  <view class="card family" wx:if="{{me && me.household_id}}">
    <view class="between">
      <view class="h2">👨‍👩‍👧 {{familyTitle}}</view>
    </view>
    <view class="fam-meta">
      <view class="fam-name">{{me.household_name}} · {{memberCountText}}</view>
      <view class="fam-invite" bindtap="copyInvite">🔑 {{inviteCode}}：{{me.invite_code}} <text class="copy">{{copy}}</text></view>
    </view>
    <view class="member-row" wx:for="{{members}}" wx:key="user_id">
      <view class="m-avatar">{{item.initial}}</view>
      <view class="grow">
        <view class="m-name">
          {{item.display_name}}
          <text wx:if="{{item.is_self}}" class="self-tag">{{selfTag}}</text>
        </view>
        <view class="m-email">{{item.email}}</view>
      </view>
      <view class="role-chip {{item.role}}">{{item.roleLabel}}</view>
    </view>

    <view class="fam-actions">
      <view class="fam-btn" bindtap="openSwitch">🔄 {{familySwitch}}</view>
      <view class="fam-btn" bindtap="openJoin">➕ {{familyJoin}}</view>
      <view class="fam-btn danger" bindtap="doLeave">↩ {{familyLeave}}</view>
      <view class="fam-btn" wx:if="{{me.role === 'owner'}}" bindtap="openManage">👥 {{manageMembers}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">{{loadingTxt}}</view>

  <block wx:elif="{{hasData}}">
    <!-- SDG hero -->
    <view class="hero">
      <view class="h1">🌱 {{meSdg}}</view>
      <view class="muted">{{meSdgSub}}</view>
    </view>

    <view class="card bigs">
      <view class="big">
        <view class="big-num">{{kpi.month_saved_kg}}<text class="u"> kg</text></view>
        <view class="muted">{{monthKg}}</view>
      </view>
      <view class="big">
        <view class="big-num">HK${{kpi.month_saved_hkd}}</view>
        <view class="muted">{{monthHkd}}</view>
      </view>
      <view class="big">
        <view class="big-num">{{kpi.co2e_kg}}<text class="u"> kg</text></view>
        <view class="muted">{{monthCo2}}</view>
      </view>
    </view>

    <!-- trend -->
    <view class="card">
      <view class="h2">{{trendTitle}}</view>
      <view class="chart" wx:if="{{trend.length}}">
        <view class="bar-col" wx:for="{{trend}}" wx:key="month">
          <view class="bar-val">{{item.saved_kg}}</view>
          <view class="bar-wrap"><view class="bar" style="height: {{item.pct}}%;"></view></view>
          <view class="bar-label">{{item.label}}</view>
        </view>
      </view>
      <view wx:else class="muted empty">暫無惜食紀錄</view>
    </view>

    <!-- group-buy / restock list -->
    <view class="card">
      <view class="between">
        <view class="h2">🛒 {{restockTitle}}</view>
        <view class="link" bindtap="openRestock">{{restockAdd}}</view>
      </view>
      <view wx:if="{{restock.length === 0}}" class="muted empty">{{restockEmpty}}</view>
      <view class="restock-row" wx:for="{{restock}}" wx:key="id">
        <view class="grow restock-name">
          <text class="r-icon">{{item.icon}}</text>{{item.item_name}}
          <text class="r-qty">×{{item.quantity}}</text>
        </view>
        <view class="restock-btns">
          <view class="rbtn ok" data-id="{{item.id}}" bindtap="markBought">✓ {{restockBought}}</view>
          <view class="rbtn del" data-id="{{item.id}}" bindtap="cancelRestock">✕ {{restockCancel}}</view>
        </view>
      </view>
    </view>

    <!-- preferences：一級入口（點擊開啟二級抽屜） -->
    <view class="card pref-card">
      <view class="pref-entry" bindtap="openPrefs">
        <text class="pref-entry-l">⚙️ {{prefs}}</text>
        <text class="pref-entry-r">›</text>
      </view>
    </view>
  </block>

  <view wx:else class="page-loading">暫無數據，請先在「添加」頁錄入食材</view>

  <!-- restock / group-buy drawer (simplified add: icon + name + qty) -->
  <view wx:if="{{showRestock}}" class="drawer-mask" bindtap="closeRestock"></view>
  <view wx:if="{{showRestock}}" class="drawer">
    <view class="drawer-pill"></view>
    <view class="drawer-title">{{restockAdd}}</view>

    <view class="label">{{restockCatTxt}}</view>
    <view class="cat-grid">
      <view class="cat-item {{restockPickIndex === index ? 'active' : ''}}"
            wx:for="{{cats}}" wx:key="id" data-index="{{index}}" bindtap="selectRestockCat">
        <view class="cat-icon">{{item.icon}}</view>
        <view class="cat-name">{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="label">名稱</view>
      <input class="input" value="{{restockName}}" placeholder="{{restockNamePh}}" bindinput="onRestockName" />
    </view>

    <view class="field">
      <view class="label">{{restockQtyTxt}}</view>
      <input class="input" type="number" value="{{restockQty}}" bindinput="onRestockQty" />
    </view>

    <view class="drawer-actions">
      <button class="btn-ghost" bindtap="closeRestock">{{cancel}}</button>
      <button class="btn-primary" bindtap="addRestock">{{restockAdd}}</button>
    </view>
  </view>

  <!-- family drawer (switch / join) -->
  <view wx:if="{{showFamily}}" class="drawer-mask" bindtap="closeFamily"></view>
  <view wx:if="{{showFamily}}" class="drawer">
    <view class="drawer-pill"></view>
    <view class="drawer-title">{{showFamily === 'switch' ? switchTitle : (showFamily === 'join' ? familyJoin : manageMembers)}}</view>

    <block wx:if="{{showFamily === 'switch'}}">
      <view class="hh-row" wx:for="{{myHouseholds}}" wx:key="id"
            data-id="{{item.id}}" bindtap="switchHousehold">
        <view class="grow">
          <view class="hh-name">
            🏠 {{item.name}}
            <text wx:if="{{item.id === me.household_id}}" class="self-tag">{{current}}</text>
          </view>
          <view class="hh-meta">{{item.roleLabel}} · {{item.member_count}} 人</view>
        </view>
      </view>
    </block>

    <block wx:if="{{showFamily === 'join'}}">
      <view class="field">
        <input class="input" value="{{joinCode}}" placeholder="{{joinCodePh}}" bindinput="onJoinCode" />
      </view>
      <view class="err" wx:if="{{joinErr}}">{{joinErr}}</view>
      <view class="drawer-actions">
        <button class="btn-ghost" bindtap="closeFamily">{{cancel}}</button>
        <button class="btn-primary" bindtap="doJoin">{{joinBtn}}</button>
      </view>
    </block>

    <block wx:if="{{showFamily === 'manage'}}">
      <view class="member-row" wx:for="{{members}}" wx:key="user_id">
        <view class="m-avatar">{{item.initial}}</view>
        <view class="grow">
          <view class="m-name">{{item.display_name}} <text wx:if="{{item.is_self}}" class="self-tag">{{selfTag}}</text></view>
          <view class="m-email">{{item.email}}</view>
        </view>
        <block wx:if="{{!item.is_self}}">
          <view class="mini-btn" data-id="{{item.user_id}}" bindtap="transferOwner">{{transferOwner}}</view>
          <view class="mini-btn danger" data-id="{{item.user_id}}" bindtap="removeMember">{{removeMember}}</view>
        </block>
      </view>
    </block>
  </view>

  <!-- preferences drawer（二級：主題 + 長輩大字；繁體中文為唯一語言） -->
  <view wx:if="{{showPrefs}}" class="drawer-mask" bindtap="closePrefs"></view>
  <view wx:if="{{showPrefs}}" class="drawer">
    <view class="drawer-pill"></view>
    <view class="drawer-title">{{prefs}}</view>

    <view class="pref-row">
      <view class="pref-lbl">🌐 界面語言</view>
      <view class="seg mini-seg">
        <view class="pseg active">繁體中文</view>
      </view>
    </view>

    <view class="pref-row">
      <view class="pref-lbl">🎨 {{prefTheme}}</view>
      <view class="seg mini-seg">
        <view class="pseg {{theme === 'light' ? 'active' : ''}}" data-theme="light" bindtap="setTheme">{{prefLight}}</view>
        <view class="pseg {{theme === 'dark' ? 'active' : ''}}" data-theme="dark" bindtap="setTheme">{{prefDark}}</view>
      </view>
    </view>

    <view class="pref-row">
      <view class="pref-lbl">👵 {{prefFont}}</view>
      <view class="seg mini-seg">
        <view class="pseg {{font === 'normal' ? 'active' : ''}}" data-font="normal" bindtap="setFont">{{font100}}</view>
        <view class="pseg {{font === 'large' ? 'active' : ''}}" data-font="large" bindtap="setFont">{{font125}}</view>
      </view>
    </view>
  </view>
</view>
